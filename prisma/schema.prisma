// Prisma schema for PayGo Integration Lab
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiRequestLog {
  id                String   @id @default(uuid())
  provider          String   @default("paygo")
  endpoint          String
  method            String
  requestId         String   @map("request_id")
  httpStatus        Int      @map("http_status")
  durationMs        Int      @map("duration_ms")
  success           Boolean
  sanitizedRequest  String   @map("sanitized_request") @db.Text
  sanitizedResponse String   @map("sanitized_response") @db.Text
  errorCode         String?  @map("error_code")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([requestId])
  @@index([endpoint])
  @@index([createdAt])
  @@map("api_request_logs")
}

model TestProduct {
  id                 String        @id @default(uuid())
  paygoProductId     String        @unique @map("paygo_product_id")
  name               String
  price              Decimal       @db.Decimal(12, 2)
  paymentMulticaixa  Boolean       @default(true) @map("payment_multicaixa")
  paymentReference   Boolean       @default(true) @map("payment_reference")
  paymentStripe      Boolean       @default(false) @map("payment_stripe")
  createdAt          DateTime      @default(now()) @map("created_at")
  payments           TestPayment[]

  @@map("test_products")
}

enum PaymentStatus {
  CREATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  UNKNOWN
  AMOUNT_MISMATCH
}

model TestPayment {
  id               String        @id @default(uuid())
  paygoPaymentId   String?       @unique @map("paygo_payment_id")
  testProductId    String?       @map("test_product_id")
  product          TestProduct?  @relation(fields: [testProductId], references: [id])
  paymentMethod    String        @map("payment_method")
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("AOA")
  status           PaymentStatus @default(CREATED)
  customerName     String        @map("customer_name")
  customerEmail    String        @map("customer_email")
  customerPhone    String        @map("customer_phone")
  idempotencyKey   String        @unique @map("idempotency_key")
  itemsJson        String?       @map("items_json") @db.Text
  rawPaygoResponse String?       @map("raw_paygo_response") @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  completedAt      DateTime?     @map("completed_at")
  failedAt         DateTime?     @map("failed_at")
  cancelledAt      DateTime?     @map("cancelled_at")

  @@index([status])
  @@index([paygoPaymentId])
  @@map("test_payments")
}

model WebhookEvent {
  id              String    @id @default(uuid())
  provider        String    @default("paygo")
  signature       String
  signatureValid  Boolean   @map("signature_valid")
  eventHash       String    @map("event_hash")
  payload         String    @db.Text
  processed       Boolean   @default(false)
  processingError String?   @map("processing_error") @db.Text
  paymentId       String?   @map("payment_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  processedAt     DateTime? @map("processed_at")

  @@index([eventHash])
  @@index([paymentId])
  @@index([signatureValid])
  @@map("webhook_events")
}
